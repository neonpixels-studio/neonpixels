// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`PrivacyPolicy > renders correctly 1`] = `
"<div data-v-771b5e01="" class="bg-bg text-fg relative font-mono">
  <header class="border-border sticky top-0 z-30 flex items-center justify-between gap-6 border-b bg-[#08080ae6] px-10 py-[22px] backdrop-blur-md" data-v-771b5e01=""><a href="/" class="flex items-center gap-[11px]" data-v-771b5e01=""><span class="font-display text-[15px] font-black tracking-[-0.01em] text-[#f2f2f4]" data-v-771b5e01=""> NEON<span class="wordmark-gradient bg-clip-text text-transparent" data-v-771b5e01="">PIXELS</span></span></a><a href="/" class="text-fg-subtle nav-link text-[12.5px]" data-v-771b5e01=""> ← back to home </a></header>
  <main data-v-771b5e01="" id="main-content" tabindex="-1" class="relative z-[2] mx-auto max-w-[720px] px-10 py-20">
    <div data-v-771b5e01="" class="text-lime mb-6 flex items-center gap-3 text-[11.5px] tracking-[0.24em] uppercase"><span data-v-771b5e01="" class="bg-lime h-px w-6"></span> privacy </div>
    <h1 data-v-771b5e01="" class="font-display m-0 mb-8 text-[clamp(30px,3.6vw,46px)] leading-[1.02] font-black tracking-[-0.025em] text-[#f2f2f4]"> Privacy Policy </h1>
    <p data-v-771b5e01="" class="text-fg-muted m-0 text-[15.5px] leading-[1.8] mb-8"> This is a small studio site with one analytics tool and one error reporting tool bolted on. This page explains, in plain language, what they collect, why, and for how long. </p>
    <section data-v-771b5e01="" class="mb-10">
      <h2 data-v-771b5e01="" class="font-display m-0 mb-4 text-[20px] font-black tracking-[-0.015em] text-[#f2f2f4]">What we collect</h2>
      <p data-v-771b5e01="" class="text-fg-muted m-0 text-[15.5px] leading-[1.8] mb-4"> If you accept the analytics banner, this site loads Google Analytics 4 (GA4), which records: </p>
      <ul data-v-771b5e01="" class="text-fg-muted m-0 mb-2 flex list-none flex-col gap-2 pl-0 text-[15.5px] leading-[1.7]">
        <li data-v-771b5e01="" class="flex gap-3"><span data-v-771b5e01="" class="text-lime">▸</span><span data-v-771b5e01="">Pageviews - which pages on this site you visit and roughly how long you stay.</span></li>
        <li data-v-771b5e01="" class="flex gap-3"><span data-v-771b5e01="" class="text-lime">▸</span><span data-v-771b5e01="">Interaction events GA4 records automatically via its Enhanced Measurement setting - such as outbound clicks on the project links (grimicorn.dev, farflung.io, basin.fm, markpost.io) - so we can tell which project people are actually curious about.</span></li>
        <li data-v-771b5e01="" class="flex gap-3"><span data-v-771b5e01="" class="text-lime">▸</span><span data-v-771b5e01="">Standard technical details GA4 collects automatically for any hit: an approximate location derived from IP address (not the IP address itself), device/browser type, and referring site.</span></li>
        <li data-v-771b5e01="" class="flex gap-3"><span data-v-771b5e01="" class="text-lime">▸</span><span data-v-771b5e01="">Two first-party cookies GA4 itself sets once you accept - _ga and _ga_&lt;container-id&gt; - which hold a random id so repeat visits can be counted as the same visitor. Both expire automatically after about 2 years, or sooner if you decline (see "Your choice" below).</span></li>
      </ul>
      <p data-v-771b5e01="" class="text-fg-muted m-0 text-[15.5px] leading-[1.8]"> We don't collect names, email addresses, or any other information you'd have to type in - there's nowhere on this site to type anything. </p>
    </section>
    <section data-v-771b5e01="" class="mb-10">
      <h2 data-v-771b5e01="" class="font-display m-0 mb-4 text-[20px] font-black tracking-[-0.015em] text-[#f2f2f4]">Error reporting</h2>
      <p data-v-771b5e01="" class="text-fg-muted m-0 text-[15.5px] leading-[1.8] mb-4"> When a script on this site crashes in your browser, the error is reported to Sentry so we can fix it. This does not depend on the analytics banner. It sends only an error report, which contains: </p>
      <ul data-v-771b5e01="" class="text-fg-muted m-0 mb-2 flex list-none flex-col gap-2 pl-0 text-[15.5px] leading-[1.7]">
        <li data-v-771b5e01="" class="flex gap-3"><span data-v-771b5e01="" class="text-lime">▸</span><span data-v-771b5e01="">The error message and a stack trace showing which of this site's scripts failed.</span></li>
        <li data-v-771b5e01="" class="flex gap-3"><span data-v-771b5e01="" class="text-lime">▸</span><span data-v-771b5e01="">The page address where it happened, with any query string and fragment removed, and the browser's name and version.</span></li>
        <li data-v-771b5e01="" class="flex gap-3"><span data-v-771b5e01="" class="text-lime">▸</span><span data-v-771b5e01="">A short trail of recent activity leading up to the error: clicks, page navigations, console messages, and the addresses of network requests the page made.</span></li>
      </ul>
      <p data-v-771b5e01="" class="text-fg-muted m-0 text-[15.5px] leading-[1.8]"> Nothing is sent when no error happens. Error reporting sets no cookies, sends no user information, and records no sessions or screen replays. Like any request, a report reaches Sentry's servers with your IP address, but we don't ask Sentry to record it. Emails, tokens and similar values are scrubbed from a report before it leaves your browser. </p>
    </section>
    <section data-v-771b5e01="" class="mb-10">
      <h2 data-v-771b5e01="" class="font-display m-0 mb-4 text-[20px] font-black tracking-[-0.015em] text-[#f2f2f4]">Why</h2>
      <p data-v-771b5e01="" class="text-fg-muted m-0 text-[15.5px] leading-[1.8]"> Analytics tells us which pages get read and which of the 4 project links get clicked, so we have a rough sense of what's worth spending more time on. Error reports tell us what is broken so we can fix it. Nothing collected here is used to advertise to you, build a profile of you, or follow you across other sites. </p>
    </section>
    <section data-v-771b5e01="" class="mb-10">
      <h2 data-v-771b5e01="" class="font-display m-0 mb-4 text-[20px] font-black tracking-[-0.015em] text-[#f2f2f4]">How long it's kept</h2>
      <p data-v-771b5e01="" class="text-fg-muted m-0 text-[15.5px] leading-[1.8]"> This site uses Google Analytics 4's own data retention controls, which cap event-level data at a maximum of 14 months before Google automatically deletes it - the exact window is a setting on the GA4 property itself, not something this codebase controls. The _ga and _ga_* cookies mentioned above expire on their own after about 2 years, or are cleared immediately if you decline via the consent banner. Error reports are kept by Sentry for a limited time under its own retention settings. </p>
    </section>
    <section data-v-771b5e01="" class="mb-10">
      <h2 data-v-771b5e01="" class="font-display m-0 mb-4 text-[20px] font-black tracking-[-0.015em] text-[#f2f2f4]">Who else sees it</h2>
      <p data-v-771b5e01="" class="text-fg-muted m-0 text-[15.5px] leading-[1.8]"> Analytics data goes to Google, who processes it as described in <a data-v-771b5e01="" href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="nav-link text-fg-subtle underline">Google's own Privacy Policy</a>. Error reports go to Sentry, who processes them as described in <a data-v-771b5e01="" href="https://sentry.io/privacy/" target="_blank" rel="noopener noreferrer" class="nav-link text-fg-subtle underline">Sentry's Privacy Policy</a>. This site has no other analytics, advertising, or tracking service embedded in it, and we don't sell or otherwise share this data ourselves. </p>
    </section>
    <section data-v-771b5e01="">
      <h2 data-v-771b5e01="" class="font-display m-0 mb-4 text-[20px] font-black tracking-[-0.015em] text-[#f2f2f4]">Your choice</h2>
      <p data-v-771b5e01="" class="text-fg-muted m-0 text-[15.5px] leading-[1.8] mb-4"> Analytics: nothing loads until you accept the banner, and you can change your mind at any time using the "Analytics choice" control that stays on-screen once you've decided. If your browser sends a Do Not Track or Global Privacy Control signal, analytics never loads at all and you're never asked. </p>
      <p data-v-771b5e01="" class="text-fg-dim m-0 text-[13px] leading-[1.7]"> GA4 measurement ID: G-Y4448RR4CR</p>
    </section>
  </main>
</div>"
`;
