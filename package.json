{
  "name": "neonpixels-landing",
  "version": "1.0.0",
  "description": "Landing page for neonpixels.dev",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "test": "vitest",
    "test:ci": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "audit": "npm audit --audit-level=high",
    "check:overrides": "node .vitepress/security/checkOverrideCompatibility.ts",
    "link:check": "node .vitepress/links/checkInternalLinks.ts",
    "perf:budget": "node .vitepress/perf/checkPerformanceBudget.ts",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "prepare": "husky",
    "lighthouse": "lhci autorun",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/jsdom": "^30.0.0",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "semver": "^7.8.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.3",
      "esbuild": "^0.25.0"
    },
    "brace-expansion": "^5.0.12",
    "rimraf": {
      "brace-expansion": "^1.1.19"
    },
    "get-uri": {
      "basic-ftp": "^6.2.5"
    }
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.7"
  }
}
