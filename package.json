{
  "name": "neonpixels-landing",
  "version": "1.0.0",
  "description": "Landing page for neonpixels.dev",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "test": "vitest",
    "test:ci": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "audit": "npm audit --audit-level=high",
    "perf:budget": "node .vitepress/perf/checkPerformanceBudget.ts",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.3",
      "esbuild": "^0.25.0"
    }
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.0"
  }
}
