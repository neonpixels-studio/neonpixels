{
  "name": "neonpixels-landing",
  "version": "1.0.0",
  "description": "Landing page for neonpixels.dev",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "build:production": "dotenvx run --strict -f .env.production -- npm run build",
    "preview": "vitepress preview",
    "test": "vitest",
    "test:ci": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "audit": "bash .github/scripts/audit.sh",
    "check:overrides": "node .vitepress/security/checkOverrideCompatibility.ts",
    "link:check": "node .vitepress/links/checkInternalLinks.ts",
    "perf:budget": "node .vitepress/perf/checkPerformanceBudget.ts",
    "lint:static": "prettier --check . && eslint .",
    "lint": "npm run lint:static && fallow audit",
    "lint:fix": "prettier --write . && eslint . --fix && fallow fix --yes",
    "prepare": "husky",
    "lighthouse": "lhci autorun",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@eslint/js": "^10.0.1",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lhci/cli": "^0.16.1",
    "@neon-pixels/eslint-config": "^0.3.0",
    "@neon-pixels/fallow-config": "^0.3.0",
    "@neon-pixels/playwright-preset": "^0.4.0",
    "@neon-pixels/prettier-config": "^0.3.0",
    "@neon-pixels/scripts": "0.3.0",
    "@neon-pixels/tsconfig": "^0.3.0",
    "@neon-pixels/vitest-preset": "^0.3.0",
    "@playwright/test": "^1.65.1",
    "@sentry/vite-plugin": "^11.18.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/jsdom": "^30.0.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "fallow": "^3.46.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "semver": "^7.8.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.1",
    "vue": "^3.5.46",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.3",
      "esbuild": "^0.25.0"
    },
    "brace-expansion": "^5.0.12",
    "rimraf": {
      "brace-expansion": "^1.1.19"
    },
    "get-uri": {
      "basic-ftp": "^6.2.5"
    }
  },
  "dependencies": {
    "@neon-pixels/consent": "^0.4.0",
    "@neon-pixels/sentry": "^0.4.0",
    "@netlify/blobs": "^11.1.9",
    "@sentry/vue": "^11.18.0"
  },
  "engines": {
    "node": "^22.17.0 || ^24.0.0 || >=26.0.0"
  }
}
