# VitePress content-hashes everything under /assets/, so a new deploy emits new
# filenames rather than mutating existing ones. The bytes at a given URL never
# change, so they are safe to cache forever. The build's CSP Report-Only block
# is appended after this (see .vitepress/csp); keep hand-written rules above it.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Files under /images/ (social card, manifest icons, SVG logos) keep stable,
# unhashed URLs, so immutable would pin stale bytes. A day of freshness skips
# the revalidation round trip on repeat visits, and stale-while-revalidate lets
# a changed file refresh in the background for a further week.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
